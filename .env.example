# Salin file ini menjadi .env lalu sesuaikan.

# ---- Server ----
PORT=3000
# 127.0.0.1 = hanya komputer ini. 0.0.0.0 = bisa dibuka dari HP/laptop lain di jaringan yang sama.
HOST=127.0.0.1

# ---- Akun admin awal (dipakai hanya saat database pertama kali dibuat) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Email (SMTP) ----
# Jika SMTP_HOST dikosongkan, email voucher TIDAK dikirim, melainkan disimpan
# sebagai file .html di folder data/outbox/ (mode uji coba).
#
# Contoh Gmail / Google Workspace (wajib pakai App Password, bukan password biasa):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=pmb@kampus.ac.id
#   SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Alamat pengirim. Kosongkan untuk memakai SMTP_USER.
MAIL_FROM=
# Nama pengirim yang tampil di kotak masuk (opsional).
MAIL_FROM_NAME=
